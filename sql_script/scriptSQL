-- Cria a tabela principal para armazenar os resultados das análises quânticas.
CREATE TABLE qcyber_analises_vqc (
    -- 'id': Identificador único para cada registro de análise.
    id INT AUTO_INCREMENT PRIMARY KEY,

    -- 'data_analise': Guarda a data e hora exatas em que a análise foi registrada.
    data_analise TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    -- 'acuracia': Acurácia da predição, armazenada como um número decimal.
    acuracia FLOAT,

    -- 'tp', 'tn', 'fp', 'fn': Componentes da matriz de confusão.
    tp INT,
    tn INT,
    fp INT,
    fn INT,

    -- 'is_alerta': Um campo booleano (0 para falso, 1 para verdadeiro) para marcar
    -- uma análise como um "alerta" que precisa de atenção.
    is_alerta BOOLEAN DEFAULT FALSE,

    -- Adiciona um índice na coluna de data para otimizar consultas.
    INDEX idx_data_analise (data_analise)

) ENGINE=InnoDB;



-- Seleciona a base de dados correta
USE monitoramento_qml;

-- Cria a tabela para armazenar os dispositivos monitorizados
CREATE TABLE IF NOT EXISTS dispositivos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    host VARCHAR(100) NOT NULL UNIQUE, -- Host/IP deve ser único
    localizacao VARCHAR(255),
    status VARCHAR(50) DEFAULT 'Ativo', -- Ex: Ativo, Inativo, Manutenção
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_nome (nome)
) ENGINE=InnoDB;

